# --- 敏感文件（绝不能入库）---
config/cookies.txt
config/cookies.txt.*
*.env

# --- 提交信息临时文件 ---
_commit_msg.txt

# --- 调试/诊断临时脚本（一次性用完不留，scripts/_rebuild_push.sh 是发布脚本例外保留）---
_chk_login.sh
_diag_img.sh
_push_acr.sh
_verify_pull.sh

# --- Python 产物 ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# --- 调试输出 ---
*.log
shots/

# --- Docker 镜像导出包（体积巨大）---
ytdl-app-*.tar.gz
*.tar.gz

# --- 系统 / 编辑器 ---
.DS_Store
Thumbs.db
*.swp
